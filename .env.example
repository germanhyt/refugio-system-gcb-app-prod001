APP_NAME="Refugio Gastronómico"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Prefer MySQL (Laragon). SQLite requires pdo_sqlite enabled.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=refugio_gastronomico
DB_USERNAME=root
DB_PASSWORD=
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="marketing@refugiogastronomico.pe"
MAIL_FROM_NAME="${APP_NAME}"
# En local el panel usa modo Simulado (log). SMTP real de marketing se configura en
# Admin → Configuraciones del sitio. El botón «Enviar correo de prueba» no sale a internet.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_TAG_MANAGER_ID=GTM-M8CTGV79
GOOGLE_ANALYTICS_ID=G-4FCNED6QVR

VITE_APP_NAME="${APP_NAME}"

REFUGIO_SOURCE_URL=https://refugiogastronomico.pe
REFUGIO_SCRAPER_DELAY_MS=500
REFUGIO_COMPLAINT_BOOK_RECIPIENTS=leilah@gcb.pe,mario@refugiogastronomico.pe,nataly@gcb.pe
